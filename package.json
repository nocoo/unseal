{
  "name": "unseal",
  "version": "0.3.0",
  "type": "module",
  "description": "Scan macOS /Applications for quarantined apps and batch-remove the quarantine attribute",
  "bin": {
    "unseal": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "debug": "bun run src/debug.ts",
    "build": "bun build src/index.ts --target=node --outdir=dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write --error-on-warnings",
    "format": "biome format --write",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json",
    "prepare": "husky"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "26.1.0",
    "@vitest/coverage-v8": "4.1.9",
    "husky": "^9.1.7",
    "typescript": "7.0.2",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.4.0"
  },
  "overrides": {
    "vite": "^8.0.16"
  }
}
