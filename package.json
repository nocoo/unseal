{
  "name": "unseal",
  "version": "0.1.1",
  "type": "module",
  "description": "Scan macOS /Applications for quarantined apps and batch-remove the quarantine attribute",
  "bin": {
    "unseal": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=node --outdir=dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.4.0"
  },
  "overrides": {
    "vite": "^8.0.16"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  }
}
